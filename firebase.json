{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/", "destination": "/mex/index.html" },
      { "source": "/mex", "destination": "/mex/index.html" },
      { "source": "/mex/**", "destination": "/mex/index.html" }
    ]
  }
}
