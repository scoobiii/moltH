{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vortex.gos3.io/schemas/protocol/execution-proof.schema.json",
  "title": "VortexExecutionProofRecord",
  "type": "object",
  "required": [
    "protocol",
    "execution_id",
    "agent",
    "repository",
    "proposal",
    "execution",
    "evidence",
    "policy",
    "proof"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "vortex-agent/v1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "$ref": "./agent.schema.json"
    },
    "repository": {
      "type": "object",
      "required": ["owner", "name", "base_commit"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "base_commit": { "type": "string", "minLength": 6 },
        "state_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "proposal": {
      "$ref": "./proposal.schema.json"
    },
    "execution": {
      "$ref": "./execution.schema.json"
    },
    "evidence": {
      "$ref": "./evidence.schema.json"
    },
    "policy": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "rules_enforced": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["algorithm", "hash"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "canonical_serialization": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
