{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vortex.gos3.io/schemas/protocol/execution.schema.json",
  "title": "VortexExecution",
  "type": "object",
  "required": ["command", "exit_code", "duration_ms", "tests"],
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "type": "integer"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "tests": {
      "type": "object",
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "cpu_user_pct": { "type": "number" },
        "memory_rss_mb": { "type": "number" },
        "io_read_bytes": { "type": "number" },
        "io_write_bytes": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
