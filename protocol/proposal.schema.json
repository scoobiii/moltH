{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vortex.gos3.io/schemas/protocol/proposal.schema.json",
  "title": "VortexProposal",
  "type": "object",
  "required": ["proposal_id", "change_hash"],
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "change_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "patch": {
      "type": "string"
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
